const startTime = "09:00";
const endTime = "17:00";
const slotTime = 30;

const workingDays = [1,2,3,4,5,6];

const ClinicTimeZone = process.env.ClinicTimeZone || "Asia/Kolkata" ;

const isrealDate = (value) => {

  if ( typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)){
    return false;
  };

  const date = new Date(`${value}T00:00:000Z`);

  return (
    !Number.isNaN(date.getTime()) && 
    date.toISOString().slice(0,10) === value
  );

}

const getClinic = () => {
  const formateDate = Intl.DateTimeFormat("en-GB",{
    timeZone: process.env.ClinicTimeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23"
  });

  const parts = Object.fromEntries(
    formateDate
    .formatToParts(new Date())
    .map(({type , value}) => [type , value])
  )

  return {
    date: `${parts.year}-${parts.month}-${parts.day}`,
    time: `${parts.hour}:${parts.minute}`
  };

};

const timetoMinutes = (time) => {
  const [hours, minutes] = time.split(":").map(Number);

  return hours * 60 + minutes ;
}